# Copier en .env puis adapter. Le fichier .env ne doit JAMAIS être commité.

# --- PostgreSQL (SA-16)
POSTGRES_DB=smartcampus
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=change-moi
# Utilisé hors Docker (uvicorn lancé à la main) :
DATABASE_URL=postgresql+psycopg://smartcampus:change-moi@localhost:5432/smartcampus

# --- API (SA-7)
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# --- Catalogue (SA-20 / SA-21)
ANNEE_UNIVERSITAIRE_COURANTE=2026-2027
# Jeton provisoire pour les routes d'écriture, en attendant SA-28 (auth et rôles)
ADMIN_API_TOKEN=genere-un-jeton-long-et-aleatoire

# --- Mémoire des conversations (SA-26)
MEMORY_BACKEND=postgres
MEMORY_TTL_MINUTES=60
MEMORY_MAX_MESSAGES=20
MEMORY_MAX_CHARS=8000
MEMORY_MAX_STORED=100

# --- Sessions visiteurs (SA-25)
VISITOR_SESSION_TTL_MINUTES=60
