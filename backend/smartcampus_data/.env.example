# Copier ce fichier vers .env puis adapter les valeurs.
# Le mot de passe ne doit jamais être écrit dans le code source.
# Les variables d'environnement déjà définies dans le processus sont prioritaires sur .env.

# Base applicative cible (les migrations 001/002/003 y sont appliquées).
DATABASE_URL=postgresql://smartcampus:REMPLACER_PAR_LE_MOT_DE_PASSE@127.0.0.1:5432/smartcampus_ai

# Base de maintenance utilisée uniquement par scripts/create_database.py pour
# créer la base applicative si elle n'existe pas. Optionnelle : si absente,
# l'URL est dérivée de DATABASE_URL en remplaçant le nom de base par "postgres".
DATABASE_URL_ADMIN=postgresql://postgres:REMPLACER_PAR_LE_MOT_DE_PASSE@127.0.0.1:5432/postgres

# Jeu de tests : obligatoire pour exécuter pytest contre une vraie base PostgreSQL.
# Utiliser une base dédiée, JAMAIS la base de production.
DATABASE_URL_TEST=postgresql://smartcampus_test:REMPLACER_PAR_LE_MOT_DE_PASSE@127.0.0.1:5432/smartcampus_ai_test
